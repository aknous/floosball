.git
.gitignore
.venv
# Docker anchors patterns at the context root: a bare `*.pyc` matches only top-level
# files, so the nested bytecode under api/ and managers/ shipped anyway.
**/__pycache__
**/*.pyc
data/*.db*
data/avatars/
# Local test / backup / scratch data — never ship to the image. The prod DB
# lives on the Fly volume mounted at /data (DATABASE_DIR=/data), not the build
# context, so the repo data/ dir is dev-only. These dirs were ~1.5GB.
data/backups/
data/awardstest/
data/simtest/
data/**/*.db*
**/.DS_Store
logs/
legacy/
tests/
examples/
*.md
.vscode/
.claude/
# External reference datasets (NFL Big Data Bowl tracking CSVs + zips, ~10GB). Used by
# local analysis harnesses only; nothing at runtime reads them. Without this every
# `fly deploy` uploaded them as build context.
data/datasets/
